{
  // Bản tĩnh của Lulla trên Cloudflare (Worker chỉ phục vụ file tĩnh)
  "name": "lulla",
  // Tên miền riêng (thay trang cũ ở doun.online)
  "routes": [{ "pattern": "doun.online", "custom_domain": true }],
  "account_id": "1c0adc78064b569dcf22aa40bd6f32d8",
  "workers_dev": true,
  "compatibility_date": "2026-11-01",
  "main": "worker/index.js",
  // Tải nhạc lên: Worker commit file vào repo này (secret SITE_PASSWORD, GITHUB_TOKEN đặt riêng)
  "vars": { "GITHUB_REPO": "nguyendoun/lulla", "DEPLOY_WORKFLOW": "deploy.yml" },
  "assets": {
    "directory": ".output/public",
    "binding": "ASSETS",
    "run_worker_first": true, // mọi request qua Worker để kiểm tra đăng nhập
    // Đường dẫn như /stats, /library tải lại vẫn ra app
    "not_found_handling": "single-page-application"
  }
}
