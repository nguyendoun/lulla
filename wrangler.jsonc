{
  // Bản tĩnh của Lulla trên Cloudflare (Worker chỉ phục vụ file tĩnh)
  "name": "lulla",
  // Tên miền riêng (thay trang cũ ở doun.online)
  "routes": [{ "pattern": "doun.online", "custom_domain": true }],
  "workers_dev": true,
  "compatibility_date": "2026-11-01",
  "main": "worker/index.js",
  "assets": {
    "directory": ".output/public",
    "binding": "ASSETS",
    "run_worker_first": ["/media/*"],
    // Đường dẫn như /stats, /library tải lại vẫn ra app
    "not_found_handling": "single-page-application"
  }
}
